// Add ONLY this match inside your existing /databases/{database}/documents block.
// Keep userAccess, logbook and logbookPilots rules unchanged.
match /activity_timeline/{eventId} {
  allow read: if true;
  allow create, update, delete: if request.auth != null
    && request.auth.token.email == 'timeline-admin@transwisata-apps.example';
}
