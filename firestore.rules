rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /activity_timeline/{eventId} {
   allow read: if true;
   // Hanya akun Email/Password yang dibuat oleh administrator.
   // Nonaktifkan public self-registration di Firebase Authentication.
   allow create, update, delete: if request.auth != null
      && request.auth.token.firebase.sign_in_provider == 'password';
  }
 }
}
